# Comma-separated list of allowed frontend origins for CORS.
# Local dev default (used when this var is unset): http://localhost:5173,http://127.0.0.1:5173
# Production (Render): set this to your Vercel deployment URL(s), e.g.
# https://dataqx.vercel.app,https://dataqx-git-main-yourname.vercel.app
DATAQX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# development | production -- informational only, no behavior currently branches on it.
DATAQX_ENV=development

# Maximum accepted upload size, in megabytes.
DATAQX_MAX_UPLOAD_MB=200
